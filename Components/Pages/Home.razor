@page "/"
<PageTitle>Pi — Engineering Portfolio</PageTitle>
<HeadContent><meta name="description" content="Pi's portfolio of embedded systems, automation, IoT and backend engineering projects." /></HeadContent>
<section class="hero" aria-labelledby="intro-title">
<div><span class="hero-tag">PORTFOLIO // PI</span><p>Hello, I'm Pi.</p><h1 id="intro-title">The software between the hardware and the network.</h1><p class="hero-lede">Embedded firmware, industrial automation, IoT, and the C# services that connect them.</p><div class="hero-actions"><a class="button button-primary" href="#projects">View projects ↗</a><a class="button" href="#contact">Contact me</a></div></div>
<div class="portrait-card">
<div class="portrait-placeholder" role="img" aria-label="Radiating Pi engineering emblem"><span aria-hidden="true">π</span><small>PI / ENGINEERING</small></div>
<p class="portrait-caption">Embedded &amp; Backend Engineering</p></div>
</section>
<section id="projects" class="home-section" aria-labelledby="projects-title">
<div class="section-heading"><div><span class="hero-tag">01 // SELECTED WORK</span><h2 id="projects-title">Featured projects</h2></div><p>From connected devices to operational dashboards.</p></div>
<div class="project-carousel" role="region" aria-roledescription="carousel" aria-labelledby="projects-title">
<div id="project-track" class="panel-grid carousel-track" tabindex="0" aria-label="Projects — scroll horizontally to explore">
@foreach (var project in ProjectData.All) {
<a class="panel" href="@($"/project/{project.Slug}")"><div class="panel-head"><span class="status-dot status-@project.StatusVariant" aria-hidden="true"></span><span class="panel-status">@project.Status</span></div><h3>@project.Name</h3><p class="panel-tagline">@project.Tagline</p><ul class="panel-stack">@foreach (var tech in project.Stack) { <li>@tech</li> }</ul><span class="project-link">Explore project ↗</span></a>
}
</div>
<div class="carousel-toolbar"><span class="carousel-count" aria-live="polite">@ProjectData.All.Count projects</span><div class="carousel-controls"><button type="button" class="carousel-prev" aria-label="Previous projects" aria-controls="project-track" hidden>&lt;</button><button type="button" class="carousel-next" aria-label="Next projects" aria-controls="project-track" hidden>&gt;</button></div></div>
</div></section>
<section id="about" class="home-section about-section" aria-labelledby="about-title">
    <div class="about-profile">
        <span class="hero-tag">02 // THE ENGINEER</span>
        <h2 id="about-title">About me</h2>
        <div class="about-photo-frame">
            @if (!string.IsNullOrWhiteSpace(ProfileData.PhotoUrl))
            {
                <img class="about-photo" src="@ProfileData.PhotoUrl" alt="Portrait of @(ProfileData.FullName ?? "Pi")" width="320" height="320" loading="lazy" />
            }
            else
            {
                <div class="about-photo-placeholder"><span aria-hidden="true">π</span><small>PROFILE PHOTO</small></div>
            }
        </div>
    </div>
    <div class="about-bio">
        <span class="about-field-label">FULL NAME</span>
        <h3 class="about-full-name">@(string.IsNullOrWhiteSpace(ProfileData.FullName) ? "Pi" : ProfileData.FullName)</h3>
        <div class="about-location">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
            <div><span class="about-field-label">ADDRESS</span><span>@(string.IsNullOrWhiteSpace(ProfileData.Address) ? "Location coming soon" : ProfileData.Address)</span></div>
        </div>
        <p class="about-lede">My work connects devices, services, and the people who use them.</p>
        <p>My project collection spans embedded systems, industrial automation, environmental sensing, and server monitoring. I work across hardware integrations and C# backends to bring those systems together.</p>
        <ul class="expertise-list"><li>Embedded systems</li><li>Backend development</li><li>Industrial automation</li><li>Connected devices</li></ul>
    </div>
</section>
<section id="contact" class="home-section contact-section" aria-labelledby="contact-title"><span class="hero-tag">03 // GET IN TOUCH</span><h2 id="contact-title">Let's build something connected.</h2><p>For project conversations, engineering opportunities, or a closer look at my work.</p>
<div class="contact-links">
    @if (!string.IsNullOrWhiteSpace(ProfileData.Email))
    {
        <a class="contact-card" href="@($"mailto:{ProfileData.Email}")">
            <span class="contact-symbol" aria-hidden="true">@@</span>
            <span><span class="contact-label">EMAIL</span><strong>@ProfileData.Email</strong><small>Start a conversation</small></span>
            <span class="contact-arrow" aria-hidden="true">↗</span>
        </a>
    }
    else
    {
        <div class="contact-card contact-card-pending"><span class="contact-symbol" aria-hidden="true">@@</span><span><span class="contact-label">EMAIL</span><strong>Email address coming soon</strong><small>Let's talk about your next project</small></span></div>
    }
    @if (!string.IsNullOrWhiteSpace(ProfileData.GitHubUrl))
    {
        <a class="contact-card" href="@ProfileData.GitHubUrl" target="_blank" rel="noopener noreferrer" aria-label="View my GitHub profile (opens in a new tab)">
            <svg class="contact-symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m8 7-5 5 5 5m8-10 5 5-5 5m-3-14-2 18" /></svg>
            <span><span class="contact-label">GITHUB</span><strong>Explore my code</strong><small>@ProfileData.GitHubUrl</small></span>
            <span class="contact-arrow" aria-hidden="true">↗</span>
        </a>
    }
    else
    {
        <div class="contact-card contact-card-pending"><span class="contact-symbol" aria-hidden="true">&lt;/&gt;</span><span><span class="contact-label">GITHUB</span><strong>GitHub profile coming soon</strong><small>Projects, repositories, and experiments</small></span></div>
    }
</div>
@if (!string.IsNullOrWhiteSpace(ProfileData.LinkedInUrl))
{
    <a class="contact-linkedin" href="@ProfileData.LinkedInUrl" target="_blank" rel="noopener noreferrer">Connect on LinkedIn ↗</a>
}
</section>


