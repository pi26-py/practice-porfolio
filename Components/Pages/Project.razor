@page "/project/{Slug}"

@if (project is null)
{
    <PageTitle>Project not found</PageTitle>
    <p role="alert">No project matches "@Slug".</p>
    <a class="back-link" href="/">&larr; Back to all projects</a>
}
else
{
    <PageTitle>@project.Name — Pi's Portfolio</PageTitle>

    <a class="back-link" href="/">&larr; Back to all projects</a>

    <article class="project-detail">
        <header>
            <div class="panel-head">
                <span class="status-dot status-@project.StatusVariant" aria-hidden="true"></span>
                <span class="panel-status">@project.Status</span>
            </div>
            <h1>@project.Name</h1>
            <p class="hero-lede">@project.Tagline</p>
        </header>

        <p class="project-summary">@project.Summary</p>

        <h2>Stack</h2>
        <ul class="panel-stack panel-stack--wide">
            @foreach (var tech in project.Stack)
            {
                <li>@tech</li>
            }
        </ul>

        <h2>Highlights</h2>
        <ul class="highlight-list">
            @foreach (var item in project.Highlights)
            {
                <li>@item</li>
            }
        </ul>
    </article>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private ProjectInfo? project;

    protected override void OnParametersSet()
    {
        project = ProjectData.Find(Slug);
    }
}
